# Copy to .env and set to your Ghidra install root.
# Must contain support/LaunchSupport.jar (e.g. GHIDRA_12_0_PUBLIC).
GHIDRA_INSTALL_DIR=

# Optional: Claude API key for the LLM-based challenger-lane candidate rewrite
# mechanism (proof-scale --autonomous-max-llm-calls). Only required when that
# budget is set above 0; the mechanism no-ops safely (typed "llm-unavailable"
# terminal) when this is unset.
ANTHROPIC_API_KEY=
